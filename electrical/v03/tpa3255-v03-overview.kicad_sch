  (text "TPA3255 V0.3｜整合電路圖" (at 25.4 22.86 0) (effects (font (face "Noto Sans CJK TC") (size 5 5)) (justify left)) (uuid 3b0791d8-67bb-5223-b341-1a9b032aa460))
  (text "音訊由左向右；四路回授繞回輸入；下方為供電與啟停控制。" (at 25.4 40.64 0) (effects (font (face "Noto Sans CJK TC") (size 2.2 2.2)) (justify left)) (uuid 9d5b6117-6bb1-5988-b9bc-39a260fe492c))
  (text "所有 180 個元件皆保留。相同電源／偏壓標籤表示相連；導線交叉僅有圓點才相接。" (at 25.4 779.78 0) (effects (font (face "Noto Sans CJK TC") (size 2 2)) (justify left)) (uuid 9558a39c-600c-58d0-a021-024d153a967f))
  (text "低壓音訊與控制草案；機內市電區另圖。尚未走線及實機驗證。" (at 25.4 797.56 0) (effects (font (face "Noto Sans CJK TC") (size 2 2)) (justify left)) (uuid 16bdeb42-d54a-57f2-b6ad-45a28cbaac49))
