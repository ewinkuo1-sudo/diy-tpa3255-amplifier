  (text "延後切斷 48V" (at 533.4 614.68 0) (effects (font (face "Noto Sans CJK TC") (size 1.8 1.8)) (justify left)) (uuid b525a259-84d7-59c3-8e93-86332299f519))
  (text "48V 機內電源 → 保險絲 → 反接保護 → eFuse → 功率級 PVDD" (at 604.52 807.72 0) (effects (font (face "Noto Sans CJK TC") (size 2 2)) (justify left)) (uuid ec7bdd09-026b-5df5-90b1-a53a6158b6eb))
  (text "48V 成立與延遲開聲 → RESET_N" (at 965.2 652.78 0) (effects (font (face "Noto Sans CJK TC") (size 2 2)) (justify left)) (uuid 6e462589-ab74-52aa-b1c2-96ade1c57b01))
  (text "前級 Trigger 回路隔離；TRIG_RETURN 不接 GND" (at 25.4 713.74 0) (effects (font (face "Noto Sans CJK TC") (size 1.8 1.8)) (justify left)) (uuid 109ed506-da92-509c-91b1-26078394bba5))
