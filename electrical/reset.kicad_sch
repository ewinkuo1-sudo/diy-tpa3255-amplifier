0 158 0) (effects (font (size 1.5 1.5)) (justify left))(uuid 68da3209-8e03-555c-af37-176fe6ef20e6))(text "1. Keep JP1 open or 2-3 shorted. Connect only dummy loads." (at 25 205 0) (effects (font (size 2 2)) (justify left))(uuid 6cb72f48-0f1b-5c18-98d0-992a8eaf9742))(text "2. Apply 12V and PVDD. Confirm rails and wait >= 250ms after PVDD." (at 25 218 0) (effects (font (size 2 2)) (justify left))(uuid c4ae9667-f053-52dc-b83a-50591908f361))(text "3. Move JP1 to 1-2 to run. Start with small input and low PVDD." (at 25 231 0) (effects (font (size 2 2)) (justify left))(uuid 4711da12-6e03-50bf-aaae-e2c776933beb))(text "4. Return JP1 to 2-3 before switching power off." (at 25 244 0) (effects (font (size 2 2)) (justify left))(uuid 66682c65-9667-5764-aac7-64f1e0988fe9))(text "Do not use with speakers until automatic supply supervision and shutdown are designed." (at 25 262 0) (effects (font (size 1.6 1.6)) (justify left))(uuid 9542256e-7ea9-5b95-a5d9-d2b27004db84)))
